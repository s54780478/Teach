# Copy to .env.local and fill in your project values.
# Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only：Webhook / Checkout 寫入 subscriptions
SUPABASE_SERVICE_ROLE_KEY=

# 網站對外網址（藍新 ReturnURL / NotifyURL / OAuth redirect 必須可被公網打到）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase Auth（Dashboard 設定）---
# Authentication → Providers：啟用 Google / LINE / Apple / Facebook / GitHub / Discord / Email
# Authentication → URL Configuration：
#   Site URL = NEXT_PUBLIC_APP_URL
#   Redirect URLs 加入：{APP_URL}/auth/callback
# Authentication → Providers → Email：可開 Magic Link
# 帳號自動合併（同 Email 綁同一 user）：
#   Authentication → Settings → 啟用 Automatic Linking（或 Manual Linking + 客戶端 linkIdentity）
# Apple 若使用者隱藏 Email：前端會引導一次性綁定真實 Email 作為主鍵
#
# Storage（頭像／證件上傳）：
#   於 SQL Editor 執行 supabase/storage_avatars.sql
#   建立公開 bucket `avatars`；前端會壓縮後再上傳，費用通常很低
# 帳戶個人資料欄位：
#   於 SQL Editor 執行 supabase/account_profiles.sql
#
# 已不建議開啟：列表會自動合併示範導師（tutor-*）+ 真實註冊導師。
# NEXT_PUBLIC_USE_MOCK_TUTORS=false
# 若要同步示範導師寫入 DB：執行 supabase/seed_tutors_refresh.sql
#
# 三層技能分類（categories / subcategories / tags / tutor_tags）：
#   於 SQL Editor 執行 supabase/taxonomy.sql
# 標籤防禦（正規化唯一、pg_trgm、檢舉自動隱藏）：
#   於 SQL Editor 執行 supabase/taxonomy_tag_defense.sql


# --- 藍新金流 NewebPay（正式支付）---
# 商店後台 → 串接設定 → 商店代號 / HashKey / HashIV
NEWEB_MERCHANT_ID=
NEWEB_HASH_KEY=
NEWEB_HASH_IV=
# test（ccore）| production（core）
NEWEB_STAGE=test
# 信用卡幕後是否強制 3D：0=關閉（預設）1=開啟
# NEWEB_P3D=0

# 已設定藍新時仍允許演示開通（僅開發用）
# ALLOW_DEMO_CHECKOUT=true

# （相容別名，可選）
# NEWEBPAY_MERCHANT_ID=
# NEWEBPAY_HASH_KEY=
# NEWEBPAY_HASH_IV=
