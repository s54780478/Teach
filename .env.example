# Copy to .env.local and fill in your project values.
# Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only：Webhook / Checkout 寫入 subscriptions
SUPABASE_SERVICE_ROLE_KEY=

# 網站對外網址（藍新 ReturnURL / NotifyURL 必須可被公網打到）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 藍新金流 NewebPay（正式支付）---
# 商店後台 → 串接設定 → 商店代號 / HashKey / HashIV
NEWEB_MERCHANT_ID=
NEWEB_HASH_KEY=
NEWEB_HASH_IV=
# test（ccore）| production（core）
NEWEB_STAGE=test
# 信用卡幕後是否強制 3D：0=關閉（預設）1=開啟
# NEWEB_P3D=0

# 已設定藍新時仍允許演示開通（僅開發用）
# ALLOW_DEMO_CHECKOUT=true

# （相容別名，可選）
# NEWEBPAY_MERCHANT_ID=
# NEWEBPAY_HASH_KEY=
# NEWEBPAY_HASH_IV=
